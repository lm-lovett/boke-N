# ===== Dependencies =====
node_modules/
backend/python_modules/

# ===== Build output =====
frontend/dist/
frontend/dist-ssr/
backend/.wrangler/

# ===== Env files (secrets stay local; public config tracked) =====
.env
.env.*
!frontend/.env.production
*.local

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.venv-workers/
.pytest_cache/
.coverage
htmlcov/
pylock.toml

# ===== Backend / Workers =====
backend/data/*.db
backend/worker-configuration.d.ts
data/db.json

# ===== IDE / Editor =====
.idea/
.vscode/*
!frontend/.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== OS =====
.DS_Store
Thumbs.db

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== WorkBuddy =====
.workbuddy/
frontend/.workbuddy/

